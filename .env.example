# 前端唯一对外端口
FRONTEND_PORT=8080

# 后端
API_PORT=8080
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
DATABASE_URL=postgres://go_react_starter:change-me@postgres:5432/go_react_starter?sslmode=disable
REDIS_URL=redis://:change-me@redis:6379/0

# PostgreSQL 容器初始化
POSTGRES_USER=go_react_starter
POSTGRES_PASSWORD=change-me
POSTGRES_DB=go_react_starter

# Redis 容器
REDIS_PASSWORD=change-me

# Vite/浏览器 API 根路径
VITE_API_BASE_URL=/api/v1
