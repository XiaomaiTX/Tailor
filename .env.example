# 前端唯一对外端口
FRONTEND_PORT=8080

# 后端
API_PORT=8080
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
DATABASE_PATH=./data/app.db

# Headscale 单实例连接（API Key 仅由后端使用）
HEADSCALE_URL=https://headscale.example.com
HEADSCALE_API_KEY=replace-with-your-headscale-api-key
# 初始/回退值；管理员可在系统设置页调整
HEADSCALE_SYNC_INTERVAL_SECONDS=60

# Tailor 是 OIDC 客户端；在同一 IdP 为 Tailor 单独注册 Client。
# 回调地址必须与 IdP 注册值一致，例如 https://tailor.example.com/api/v1/auth/callback
OIDC_ISSUER_URL=https://sso.example.com
OIDC_CLIENT_ID=tailor-client-id
OIDC_CLIENT_SECRET=replace-with-tailor-oidc-client-secret
OIDC_REDIRECT_URL=https://tailor.example.com/api/v1/auth/callback

# 逗号分隔的 Headscale Policy Group 名称；管理员还可由服务端 Bootstrap 用户兜底。
PEER_RELAY_BOOTSTRAP_ADMINS=admin@example.com
PEER_RELAY_ADMIN_GROUPS=group:relay-admin
PEER_RELAY_REVIEWER_GROUPS=group:relay-reviewer
PEER_RELAY_APPLICANT_MODE=all
PEER_RELAY_APPLICANT_GROUPS=group:relay-applicant
# 初始/回退值；管理员可在系统设置页调整
PEER_RELAY_SELF_SERVICE_ENABLED=true

# 默认关闭；确认 Headscale 使用 policy.mode=database 且已验证 Peer Relay Grants 支持后再开启。
PEER_RELAY_POLICY_WRITES=false

# Vite/浏览器 API 根路径
VITE_API_BASE_URL=/api/v1
